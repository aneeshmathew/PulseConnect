# Absolute URL of your deployed backend's GraphQL endpoint. This is read
# only by production builds (`vite build`, which is what Vercel runs) —
# `npm run dev` always talks to your local backend regardless of what's
# set here, so it's safe to leave this in a local .env file without
# breaking local development. Set the real value in your Vercel frontend
# project's Environment Variables, not necessarily here.
VITE_GRAPHQL_URL=https://your-backend.vercel.app/graphql

# Only needed if you enable subscriptions (see below) — the WebSocket URL
# of a backend that supports persistent connections. Same DEV-only
# exemption as above: ignored by `npm run dev`.
VITE_WS_URL=wss://your-backend.example.com/graphql

# Vercel serverless functions can't hold WebSocket connections open, so
# live/real-time GraphQL subscriptions don't work against a backend
# deployed with backend/api/. Leave this false (default) unless you've
# deployed the WebSocket server elsewhere — see ../DEPLOYMENT.md.
# `npm run dev` always has subscriptions on against your local backend,
# regardless of this setting.
VITE_ENABLE_SUBSCRIPTIONS=false
